# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env

# development | test | production
NODE_ENV=development

# 3001, because Next.js dev already uses 3000.
PORT=3001

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string. Replace user, password and cluster host.
# The password must be URL-encoded: @  ->  %40   #  ->  %23   /  ->  %2F
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=moka-pos

# --- Sessions -------------------------------------------------------------
# Signing key for the session cookie. Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=12

# --- Browser access -------------------------------------------------------
# Comma-separated list of allowed origins. Must match the frontend exactly —
# including scheme and port — because session cookies are credentials.
CORS_ORIGIN=http://localhost:3000

# Set true when served over HTTPS. Required in production: the API refuses to
# start with NODE_ENV=production and COOKIE_SECURE=false, because a session
# cookie without `Secure` can travel over plain HTTP. Leave false for local
# plain-HTTP development.
COOKIE_SECURE=false

# Express `trust proxy` setting. Leave unset for a direct connection; set to 1
# when exactly one reverse proxy (Vercel, nginx) is in front, or to a
# subnet/CIDR list. Never set 1 on a directly reachable server: clients could
# spoof X-Forwarded-For and evade the per-IP rate limits.
#TRUST_PROXY=1

# --- Shop settings --------------------------------------------------------
# The shop's wall-clock timezone. Report day boundaries are resolved here, so a
# wrong value shifts sales across midnight rather than changing a total.
STORE_TIMEZONE=Asia/Jakarta

# Indonesian VAT as a fraction. 0.1 = 10%.
TAX_RATE_DEFAULT=0.1

# --- Hardening --------------------------------------------------------------
# Pino level: debug | info | warn | error | fatal | trace | silent
# Defaults to info (silent under NODE_ENV=test).
#LOG_LEVEL=info

# Login attempts allowed per IP per 15 minutes.
#RATE_LIMIT_LOGIN_MAX=30

# Failed sign-ins allowed per username per 15 minutes. Successful sign-ins do
# not count against this.
#RATE_LIMIT_LOGIN_USERNAME_MAX=20

# Password-change attempts allowed per user+IP per 15 minutes.
#RATE_LIMIT_PASSWORD_MAX=10

# Requests allowed per IP per minute across the whole API. A backstop against
# runaway clients; set well above what a real shop generates.
#RATE_LIMIT_API_MAX=2000