# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env

# development | test | production
NODE_ENV=development

# 3001, because Next.js dev already uses 3000.
PORT=3001

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string. Replace user, password and cluster host.
# The password must be URL-encoded: @  ->  %40   #  ->  %23   /  ->  %2F
MONGODB_URI=mongodb://127.0.0.1:65291/moka-pos?replicaSet=testset

# --- Sessions -------------------------------------------------------------
# Signing key for the session cookie. Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=8e0c4e27c8f5b829c0f2f4e8d279796112a750bda4f2fd80656581e640dcf85a
SESSION_TTL_HOURS=12

# --- Browser access -------------------------------------------------------
# Comma-separated list of allowed origins. Must match the frontend exactly â€”
# including scheme and port â€” because session cookies are credentials.
CORS_ORIGIN=http://localhost:3000

# Set true only when served over HTTPS. Leaving this false behind HTTPS works,
# but setting it true behind plain HTTP makes the browser silently drop the
# cookie and login appears to do nothing.
COOKIE_SECURE=false

# --- Shop settings --------------------------------------------------------
# The shop's wall-clock timezone. Report day boundaries are resolved here, so a
# wrong value shifts sales across midnight rather than changing a total.
STORE_TIMEZONE=Asia/Jakarta

# Indonesian VAT as a fraction. 0.1 = 10%.
TAX_RATE_DEFAULT=0.1
# Local ceilings: the smoke suites concentrate hundreds of requests per minute
# from one IP, which the production defaults (30 / 2000) would throttle.
# Raise these on a dev machine only; production keeps the defaults.
RATE_LIMIT_LOGIN_MAX=1000
RATE_LIMIT_API_MAX=500000
