# Public, so it reaches the browser bundle. The API keeps the real secret.
#
#   cp .env.local.example .env.local
#
# The session is an httpOnly cookie, so no API key or token belongs here. The
# only thing the browser needs is where the API is.
#
# Local: point straight at the API process (same-site via localhost, so the
# session cookie works without a proxy).
#
# Vercel production: set NEXT_PUBLIC_API_URL to this app's OWN production URL
# (so the browser stays same-origin) and API_PROXY_TARGET to the API project's
# URL — next.config.ts rewrites /api/* to that target. API_PROXY_TARGET is
# server-side only; it is not inlined into the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Fallback for the zone report days are grouped in. At runtime the app adopts
# the zone the API advertises on GET /api/config, so this no longer has to match
# the backend's STORE_TIMEZONE exactly — but set it to the same value so the
# calendar is right from the first render, before config replies.
NEXT_PUBLIC_STORE_TIMEZONE=Asia/Jakarta
