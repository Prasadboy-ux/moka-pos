# Frontend environment. Copy this to .env.local:
#
#   cp .env.local.example .env.local
#
# These values configure the Next.js server. The session is an httpOnly cookie,
# so no API key or token belongs here.
#
# The browser calls this app's own `/api` path and `next.config.ts` forwards it
# to API_PROXY_TARGET. That keeps the cookie on one origin and makes the same
# build work whether it is opened at localhost, a LAN address, or a deployed
# domain — no hostname is baked into the browser bundle.
#
# Local: the API process on :3001.
# Vercel: set API_PROXY_TARGET to the API project's production URL.
#
# API_PROXY_TARGET is server-side only; it is not inlined into the browser.
API_PROXY_TARGET=http://localhost:3001

# Optional. Only set this when the browser must call the API directly instead
# of going through the rewrite. It must be an origin every user's browser can
# reach (never localhost if the site is opened from another device), and the
# API's CORS_ORIGIN must include this app's origin.
#NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional. The login screen can show the seeded demo accounts as click-to-fill
# buttons. It is hidden unless this is exactly "true", so a production build
# that forgets the variable does not advertise admin credentials. Set it to
# true only for a demo build; the seed script still creates the accounts, so
# replace their passwords in any real deployment.
#NEXT_PUBLIC_DEMO_CREDENTIALS=true

# Fallback for the zone report days are grouped in. At runtime the app adopts
# the zone the API advertises on GET /api/config, so this no longer has to match
# the backend's STORE_TIMEZONE exactly — but set it to the same value so the
# calendar is right from the first render, before config replies.
NEXT_PUBLIC_STORE_TIMEZONE=Asia/Jakarta
